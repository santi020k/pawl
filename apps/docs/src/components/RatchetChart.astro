---
/**
 * How the ratchet behaves over a run of commits: the count the baseline allows only steps down,
 * findings stay at or under it, and a change that adds findings fails instead of landing.
 * Illustrative numbers. Colors come from the brand tokens, so it follows the theme.
 *
 * Inside a Lumen ScrollReveal, the chart draws itself once as it scrolls into view: the lines run
 * left to right and each commit's marks appear as the lines reach it. Without the reveal, without
 * JavaScript, or with reduced motion, it is drawn complete.
 */

interface Props {
  class?: string
}

const { class: className } = Astro.props

const allowed = [24, 24, 24, 20, 20, 20, 16, 16, 16, 11, 11]
const findings = [24, 23, 22, 20, 20, 19, 16, 16, 15, 11, 10]
const rejectedAt = 7
const rejectedValue = 19
const locks = [3, 6, 9]

const width = 720
const height = 300
const left = 44
const right = 700
const top = 28
const bottom = 252
const max = 28

const x = (index: number): number => left + 16 + (index * (right - left - 32)) / (allowed.length - 1)
const y = (value: number): number => bottom - (value * (bottom - top)) / max

const stepPath = allowed
  .map((value, index) => {
    if (index === 0) return `M${x(0)} ${y(value)}`

    const previous = allowed[index - 1] ?? value

    return previous === value ? `H${x(index)}` : `H${x(index)} V${y(value)}`
  })
  .join(' ')

const findingsPath = findings.map((value, index) => `${index === 0 ? 'M' : 'L'}${x(index)} ${y(value)}`).join(' ')

const gridValues = [0, 10, 20]
const rejectedFrom = findings[rejectedAt - 1] ?? 0

// Where each commit falls on the drawing timeline, from 0 to 1.
const at = (index: number): string => `--at: ${(index / (allowed.length - 1)).toFixed(3)}`
---

<figure class:list={['ratchet-chart', 'not-content', className]}>
  <svg
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-labelledby="ratchet-chart-title ratchet-chart-desc"
  >
    <title id="ratchet-chart-title">The ratchet over eleven commits</title>
    <desc id="ratchet-chart-desc">
      The number of findings the baseline allows starts at 24 and steps down to 20, 16 and 11 as the code improves. It never
      goes back up. Findings stay at or under it. At commit 8 a change would have raised findings to 19, above the 16 allowed,
      so the check failed and it did not land.
    </desc>

    {
      gridValues.map(value => (
        <g class="grid">
          <line x1={left} x2={right} y1={y(value)} y2={y(value)} />
          <text x={left - 10} y={y(value) + 4} text-anchor="end">
            {value}
          </text>
        </g>
      ))
    }

    <path class="allowed-area" d={`${stepPath} V${bottom} H${x(0)} Z`}></path>
    <path class="allowed" d={stepPath} pathLength="1"></path>
    <path class="findings" d={findingsPath} pathLength="1"></path>

    {findings.map((value, index) => <circle class="finding" cx={x(index)} cy={y(value)} r="3.5" style={at(index)} />)}

    {
      locks.map(index => (
        <g class="lock" transform={`translate(${x(index)} ${y(allowed[index] ?? 0)})`}>
          <circle r="5" style={at(index)} />
        </g>
      ))
    }

    <g class="rejected" style={at(rejectedAt)}>
      <path d={`M${x(rejectedAt - 1)} ${y(rejectedFrom)} L${x(rejectedAt)} ${y(rejectedValue)}`}></path>
      <g transform={`translate(${x(rejectedAt)} ${y(rejectedValue)})`}>
        <g class="rejected__mark">
          <circle r="9"></circle>
          <path d="M-3.5 -3.5 L3.5 3.5 M3.5 -3.5 L-3.5 3.5"></path>
        </g>
      </g>
      <text class="label--wide" x={x(rejectedAt) + 16} y={y(rejectedValue) - 6}>New findings: check fails</text>
      <text class="label--narrow" x={x(rejectedAt) + 16} y={y(rejectedValue) - 6}>check fails</text>
    </g>

    <text class="note" x={x(3) + 10} y={y(allowed[3] ?? 0) - 12} style={at(3)}>pawl baseline</text>

    <text class="axis" x={right} y={height - 14} text-anchor="end">commits →</text>
  </svg>

  <figcaption data-pagefind-ignore>
    <span class="key key--allowed">Allowed by the baseline</span>
    <span class="key key--findings">Findings</span>
    <span class="key key--rejected">Blocked change</span>
  </figcaption>
</figure>

<style>
  .ratchet-chart {
    --draw: 1.6s;
    margin: 0;
    display: grid;
    gap: 0.75rem;
    container-type: inline-size;
  }

  svg {
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--pawl-font-mono);
  }

  .grid line {
    stroke: hsl(var(--line));
    stroke-dasharray: 2 4;
  }

  .grid text,
  .axis {
    fill: hsl(var(--ink-muted));
    font-size: 11px;
  }

  .allowed-area {
    fill: hsl(var(--brand) / 0.07);
  }

  .allowed {
    fill: none;
    stroke: hsl(var(--brand));
    stroke-width: 3;
    stroke-linejoin: miter;
  }

  .findings {
    fill: none;
    stroke: hsl(var(--ink-soft));
    stroke-width: 1.5;
  }

  .finding {
    fill: hsl(var(--canvas));
    stroke: hsl(var(--ink-soft));
    stroke-width: 1.5;
  }

  .lock circle {
    fill: hsl(var(--brand));
    stroke: hsl(var(--canvas));
    stroke-width: 2;
  }

  .note {
    fill: hsl(var(--brand));
    font-size: 11px;
  }

  .rejected path {
    fill: none;
    stroke: hsl(var(--danger));
    stroke-width: 1.75;
    stroke-dasharray: 4 3;
  }

  .rejected circle {
    fill: hsl(var(--danger) / 0.14);
    stroke: hsl(var(--danger));
    stroke-width: 1.5;
  }

  .rejected g path {
    stroke-dasharray: none;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .rejected text {
    fill: hsl(var(--danger));
    font-size: 11px;
  }

  .rejected .label--narrow {
    display: none;
  }

  /* On a phone the chart is drawn at under half size: larger text and marks, and a shorter label. */
  @container (max-width: 34rem) {
    .grid text,
    .axis,
    .note,
    .rejected text {
      font-size: 28px;
    }

    .note {
      transform: translateY(-6px);
    }

    .rejected .label--wide {
      display: none;
    }

    .rejected .label--narrow {
      display: inline;
    }

    .allowed {
      stroke-width: 5;
    }

    .findings,
    .finding {
      stroke-width: 2.5;
    }

    .finding {
      r: 6px;
    }

    .lock circle {
      r: 8px;
    }

    .rejected path {
      stroke-width: 2.5;
    }

    .rejected__mark {
      transform: scale(1.5);
    }
  }

  /*
   * The drawing, keyed to Lumen's ScrollReveal: hidden while it waits, played once when revealed.
   * Screen only, so a printed page always has the whole chart.
   */
  @media screen and (prefers-reduced-motion: no-preference) {
    :global(.ui-scroll-reveal[data-ui-scroll-reveal-bound]:not(.is-revealed)) .allowed,
    :global(.ui-scroll-reveal[data-ui-scroll-reveal-bound]:not(.is-revealed)) .findings {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    :global(.ui-scroll-reveal[data-ui-scroll-reveal-bound]:not(.is-revealed)) .allowed-area,
    :global(.ui-scroll-reveal[data-ui-scroll-reveal-bound]:not(.is-revealed)) .finding,
    :global(.ui-scroll-reveal[data-ui-scroll-reveal-bound]:not(.is-revealed)) .lock,
    :global(.ui-scroll-reveal[data-ui-scroll-reveal-bound]:not(.is-revealed)) .rejected,
    :global(.ui-scroll-reveal[data-ui-scroll-reveal-bound]:not(.is-revealed)) .note {
      opacity: 0;
    }

    :global(.ui-scroll-reveal[data-ui-scroll-reveal-bound].is-revealed) .allowed,
    :global(.ui-scroll-reveal[data-ui-scroll-reveal-bound].is-revealed) .findings {
      animation: ratchet-draw var(--draw) linear backwards;
    }

    /* The shaded area follows the line across. */
    :global(.ui-scroll-reveal[data-ui-scroll-reveal-bound].is-revealed) .allowed-area {
      animation: ratchet-wipe var(--draw) linear backwards;
    }

    :global(.ui-scroll-reveal[data-ui-scroll-reveal-bound].is-revealed) .finding,
    :global(.ui-scroll-reveal[data-ui-scroll-reveal-bound].is-revealed) .rejected__mark circle {
      transform-box: fill-box;
      transform-origin: center;
      animation: ratchet-pop 240ms ease-out backwards;
      animation-delay: calc(var(--draw) * var(--at));
    }

    /* Each step down of the baseline locks in with a click. */
    :global(.ui-scroll-reveal[data-ui-scroll-reveal-bound].is-revealed) .lock circle {
      transform-box: fill-box;
      transform-origin: center;
      animation: ratchet-click 420ms cubic-bezier(0.3, 1.6, 0.5, 1) backwards;
      animation-delay: calc(var(--draw) * var(--at));
    }

    :global(.ui-scroll-reveal[data-ui-scroll-reveal-bound].is-revealed) .rejected,
    :global(.ui-scroll-reveal[data-ui-scroll-reveal-bound].is-revealed) .note {
      animation: ratchet-fade 320ms ease-out backwards;
      animation-delay: calc(var(--draw) * var(--at));
    }
  }

  @keyframes ratchet-draw {
    from {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    to {
      stroke-dasharray: 1;
      stroke-dashoffset: 0;
    }
  }

  @keyframes ratchet-wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }

    to {
      clip-path: inset(0);
    }
  }

  @keyframes ratchet-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes ratchet-pop {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }

  @keyframes ratchet-click {
    from {
      opacity: 0;
      transform: scale(0.2);
    }

    60% {
      opacity: 1;
      transform: scale(1.4);
    }
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font: 0.75rem/1.4 var(--pawl-font-mono);
    color: hsl(var(--ink-muted));
  }

  .key {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .key::before {
    content: '';
    width: 1.25rem;
    height: 0;
    border-top: 3px solid hsl(var(--brand));
  }

  .key--findings::before {
    border-top: 1.5px solid hsl(var(--ink-soft));
  }

  .key--rejected::before {
    border-top: 1.75px dashed hsl(var(--danger));
  }
</style>
