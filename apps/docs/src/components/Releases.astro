---
/**
 * The releases on the changelog page, as a timeline: the changes merged for the next release, then every version,
 * newest first. The data comes from the releases collection (src/content.config.ts).
 * Each version is an h2 like a Markdown heading, with Starlight's anchor link; src/route-data.ts adds them to the
 * table of contents.
 */
import { Badge } from '@astrojs/starlight/components'

import { formatDate, getReleases } from '../releases.ts'

const releases = await getReleases()
---

<div class="releases">
  {
    releases.map(release => (
      <section
        class:list={['release', { 'release--latest': release.latest, 'release--next': !release.version }]}
        aria-labelledby={release.id}
      >
        <div class="sl-heading-wrapper level-h2">
          <h2 id={release.id}>{release.title}</h2>
          <a class="sl-anchor-link" href={`#${release.id}`}>
            <span aria-hidden="true" class="sl-anchor-icon">
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 1 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 0 0-1.42-1.42m8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 1 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 0 0 0 1.42 1 1 0 0 0 1.42 0l3.88-3.89a4.49 4.49 0 0 0 0-6.33M8.83 15.17a1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.92-4.92a1 1 0 1 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42" />
              </svg>
            </span>
            <span class="sr-only" data-pagefind-ignore>
              Section titled “{release.title}”
            </span>
          </a>
        </div>

        <p class="release__meta">
          {release.latest && <Badge text="Latest" variant="success" />}
          {release.date ? (
            <span>
              Released <time datetime={release.date.toISOString()}>{formatDate(release.date)}</time>
            </span>
          ) : (
            <Badge text={release.version ? 'Not on npm yet' : 'Merged, not released'} variant="caution" />
          )}
          {release.links.map(link => (
            <a href={link.href}>{link.label}</a>
          ))}
        </p>

        {!release.version && (
          <p>
            These changes are on <code>main</code> and go out with the next version. Changesets picks the version
            number when the release is prepared.
          </p>
        )}

        {release.packages.map(notes => (
          <div class="release__package">
            <h3>{notes.name}</h3>
            {notes.groups.map(group => (
              <div class="release__group">
                <p class="release__kind">{group.kind}</p>
                <div class="release__notes" set:html={group.html} />
              </div>
            ))}
          </div>
        ))}
      </section>
    ))
  }

  {releases.length === 0 && <p>Nothing has been released yet.</p>}
</div>

<style>
  .releases {
    --release-rail: 1.75rem;
  }

  /*
   * A rail down the left edge, with a dot beside each version. Each section draws the rail through its own dot,
   * clipped to the section, and the sections touch, so the rail runs unbroken from the first dot to the last.
   */
  .release {
    padding-inline-start: var(--release-rail);
    padding-block-end: 1.5rem;
    overflow: visible clip;
  }

  .releases .release + .release {
    margin-block-start: 0;
  }

  .release > .sl-heading-wrapper {
    position: relative;
  }

  .release > .sl-heading-wrapper::after {
    content: '';
    position: absolute;
    inset-block: -100vh;
    inset-inline-start: calc(var(--release-rail) * -1 + 0.4375rem - 0.5px);
    border-inline-start: 1px solid var(--sl-color-hairline);
  }

  .release:first-child > .sl-heading-wrapper::after {
    inset-block-start: 50%;
  }

  .release:last-child > .sl-heading-wrapper::after {
    inset-block-end: 50%;
  }

  .release > .sl-heading-wrapper::before {
    z-index: 1;
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: calc(var(--release-rail) * -1);
    inline-size: 0.875rem;
    block-size: 0.875rem;
    translate: 0 -50%;
    border: 2px solid var(--sl-color-gray-4);
    border-radius: 50%;
    background: var(--sl-color-black);
  }

  .release--latest > .sl-heading-wrapper::before {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent);
    box-shadow: 0 0 0 4px var(--sl-color-accent-low);
  }

  .release--next > .sl-heading-wrapper::before {
    border-style: dashed;
    border-color: var(--sl-color-accent);
  }

  .release h2 {
    font-family: var(--sl-font-mono);
    letter-spacing: -0.02em;
  }

  .release--next h2 {
    font-family: var(--sl-font);
  }

  .release__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 1rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .release__meta :global(.sl-badge) {
    margin: 0;
  }

  .release h3 {
    font-size: var(--sl-text-lg);
    font-family: var(--sl-font-mono);
  }

  .release__kind {
    font: 500 0.75rem/1 var(--sl-font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
</style>
