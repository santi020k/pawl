---
import { Button, ButtonLink, Container, Drawer, NavigationMenu, SkipLink, ThemeToggle, VisuallyHidden } from '@santi020k/lumen-astro'

import PawlMark from '../PawlMark.astro'
import { npmUrl, version } from './facts.ts'

const repoUrl = 'https://github.com/santi020k/pawl'

const links = [
  { label: 'Docs', href: '/guide/getting-started/' },
  { label: 'The ratchet', href: '/guide/ratchet/' },
  { label: 'Rules', href: '/reference/rules/' }
]

// The menu on small screens also carries the links the header shows as icons.
const menuLinks = [...links, { label: 'GitHub', href: repoUrl }, { label: 'npm', href: npmUrl }]
---

<SkipLink href="#main">Skip to content</SkipLink>

<header class="site-header">
  <Container class="site-header__inner">
    <div class="site-header__brand">
      <a class="brand" href="/" aria-label="pawl, home">
        <PawlMark />
        <span>pawl</span>
      </a>
      <a class="version" href="/reference/changelog/">v{version}<VisuallyHidden>, changelog</VisuallyHidden></a>
    </div>

    <NavigationMenu variant="unstyled" class="site-nav" aria-label="Main">
      {links.map(link => <a href={link.href}>{link.label}</a>)}
    </NavigationMenu>

    <div class="site-header__actions">
      <a class="icon-link" href={repoUrl}>
        <VisuallyHidden>pawl on GitHub</VisuallyHidden>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
          ></path>
        </svg>
      </a>
      <ThemeToggle controlled storageKey="starlight-theme" />
      <ButtonLink href="/guide/getting-started/" variant="primary" class="site-header__cta">Get started</ButtonLink>
      <Button variant="outline" size="sm" class="site-menu__trigger" data-ui-drawer-trigger="site-menu">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2"></path>
        </svg>
        Menu
      </Button>
    </div>
  </Container>
</header>

<Drawer id="site-menu" class="site-menu" aria-labelledby="site-menu-title">
  <div class="site-menu__head">
    <h2 id="site-menu-title">Menu</h2>
    <Button variant="ghost" size="sm" data-ui-drawer-close>Close</Button>
  </div>
  <nav aria-label="Main">
    <ul>
      {
        menuLinks.map(link => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</Drawer>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid hsl(var(--line) / 0.7);
    background: hsl(var(--canvas) / 0.78);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
  }

  .site-header :global(.site-header__inner) {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4rem;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    color: hsl(var(--ink));
    text-decoration: none;
    font-weight: 620;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  /* The released version, linked to the changelog. */
  .version {
    position: relative;
    padding: 0.1875rem 0.5rem;
    border: 1px solid hsl(var(--line));
    border-radius: 999px;
    color: hsl(var(--ink-muted));
    font: 500 0.75rem / 1.2 var(--pawl-font-mono);
    text-decoration: none;
    transition:
      color var(--ui-duration) var(--ui-ease),
      border-color var(--ui-duration) var(--ui-ease);
  }

  /* A larger hit area than the chip it draws. */
  .version::after {
    content: "";
    position: absolute;
    inset: -0.75rem -0.25rem;
  }

  .version:hover {
    border-color: hsl(var(--brand) / 0.5);
    color: hsl(var(--brand));
  }

  .icon-link {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--ui-radius);
    color: hsl(var(--ink-soft));
    transition:
      color var(--ui-duration) var(--ui-ease),
      background-color var(--ui-duration) var(--ui-ease);
  }

  .icon-link:hover {
    background: hsl(var(--surface-muted));
    color: hsl(var(--ink));
  }

  .site-header :global(.site-nav) {
    display: flex;
    gap: 0.25rem;
    margin-inline-start: 0.5rem;
  }

  .site-header :global(.site-nav a) {
    padding: 0.375rem 0.75rem;
    border-radius: var(--ui-radius);
    color: hsl(var(--ink-soft));
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color var(--ui-duration) var(--ui-ease), background var(--ui-duration) var(--ui-ease);
  }

  .site-header :global(.site-nav a:hover) {
    color: hsl(var(--ink));
    background: hsl(var(--surface-muted));
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline-start: auto;
  }

  .site-header :global(.site-menu__trigger) {
    display: none;
    gap: 0.375rem;
    min-height: 2.75rem;
  }

  .site-menu__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-menu__head h2 {
    margin: 0;
    font: 500 0.8125rem / 1 var(--pawl-font-mono);
    color: hsl(var(--ink-muted));
  }

  :global(.site-menu) ul {
    display: grid;
    gap: 0.25rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  :global(.site-menu) ul a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--ui-radius);
    color: hsl(var(--ink));
    font-size: 1.0625rem;
    text-decoration: none;
  }

  :global(.site-menu) ul a:hover {
    background: hsl(var(--surface-muted));
    color: hsl(var(--brand));
  }

  @media (max-width: 52rem) {
    .site-header :global(.site-nav),
    .icon-link {
      display: none;
    }

    .site-header :global(.site-menu__trigger) {
      display: inline-flex;
    }
  }

  @media (max-width: 30rem) {
    .site-header :global(.site-header__cta),
    .version {
      display: none;
    }
  }
</style>
