---
/**
 * Starlight's hero. The docs have no splash pages of their own, so the only page that shows it is
 * Starlight's 404. There it says what happened and offers ways back in; any other hero renders as usual.
 */
import { LinkButton } from '@astrojs/starlight/components'
import Default from '@astrojs/starlight/components/Hero.astro'

const notFound = Astro.locals.starlightRoute.id === '404'
---

{
  notFound ?
    (
      <div class="not-found">
        <p class="not-found__code">404</p>
        <h1 id="_top" data-page-title>
          Page not found
        </h1>
        <p class="not-found__text">
          The link may be out of date, or the page has moved. Search the docs, or start from one of these.
        </p>
        <div class="not-found__actions">
          <LinkButton href="/guide/getting-started/">Getting started</LinkButton>
          <LinkButton href="/reference/rules/" variant="secondary">
            Rules
          </LinkButton>
          <LinkButton href="/reference/cli/" variant="secondary">
            CLI reference
          </LinkButton>
        </div>
      </div>
    ) :
    <Default />
}

<style>
  .not-found {
    max-width: 38rem;
    padding-block: clamp(3rem, 12vh, 8rem) 2rem;
  }

  .not-found__code {
    margin: 0;
    color: hsl(var(--brand));
    font-family: var(--pawl-font-mono);
    font-size: var(--sl-text-sm);
    font-weight: 500;
  }

  h1 {
    margin-top: 0.75rem;
    color: var(--sl-color-white);
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.5rem);
    font-weight: 640;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .not-found__text {
    margin-top: 1rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-lg);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
