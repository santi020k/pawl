---
/**
 * The page shell for the landing page. The docs use Starlight's shell; this one shares its
 * theme setting ("starlight-theme" in localStorage), so a theme picked on either side sticks.
 */
import UIPrimitives from '@santi020k/lumen-astro/runtime'
import MetadataHead from '@santi020k/og/astro/head'
import { definePageMetadata } from '@santi020k/og/metadata'
import { composeJsonLd, serializeJsonLd, softwareApplicationSchema } from '@santi020k/og/schema'

import { author, locale, siteName, website } from '../metadata.ts'

import '../styles/tokens.css'
import '../styles/landing.css'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props

// @santi020k/og writes the title, description, canonical, robots, Open Graph and X tags. The card is the hand-made og.jpg.
const page = definePageMetadata({
  pathname: Astro.url.pathname,
  title,
  description,
  type: 'website',
  image: {
    url: '/og.jpg',
    alt: 'pawl: fast guardrails for AI-written code. A steel ratchet wheel held by its pawl.',
    type: 'image/jpeg',
    width: 1200,
    height: 630
  }
})

const site = { siteUrl: Astro.site ?? Astro.url.origin, siteName, locale }
const canonical = new URL(Astro.url.pathname, site.siteUrl)

// Only facts the page itself shows: the name, the description, the license and the author.
const jsonLd = serializeJsonLd(
  composeJsonLd(
    website,
    softwareApplicationSchema(
      {
        name: siteName,
        description,
        url: canonical,
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Node.js',
        author
      },
      { image: new URL('/og.jpg', site.siteUrl).href, license: 'https://opensource.org/licenses/MIT' }
    )
  )
)
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <MetadataHead page={page} site={site} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0B0D0C" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F5F7F2" media="(prefers-color-scheme: light)" />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
    <script is:inline>
      // Same rule as Starlight's ThemeProvider, so both halves of the site agree before first paint.
      ;(() => {
        let stored = null
        try {
          stored = localStorage.getItem('starlight-theme')
        } catch {
          // Storage can be unavailable in private modes; fall back to the system setting.
        }
        const theme = stored || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
        document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark'
      })()
    </script>
  </head>
  <body>
    <slot />
    <UIPrimitives />
    <script>
      // The Lumen ThemeToggle runs in controlled mode: this page owns the theme so it can store it under
      // Starlight's key. Starlight reads "light", "dark" or "auto"; the toggle writes one of the first two.
      const root = document.documentElement

      const sync = (theme: string): void => {
        for (const toggle of document.querySelectorAll<HTMLButtonElement>('[data-ui-theme-toggle]')) {
          toggle.setAttribute('aria-pressed', String(theme === 'dark'))
          toggle.dataset.uiTheme = theme
        }
      }

      document.addEventListener('click', event => {
        const toggle = event.target instanceof Element ? event.target.closest('[data-ui-theme-toggle]') : null

        if (!toggle) return

        const next = root.dataset.theme === 'dark' ? 'light' : 'dark'

        root.dataset.theme = next
        sync(next)

        try {
          localStorage.setItem('starlight-theme', next)
        } catch {
          // Storage can be unavailable in private modes; the switch still applies to this page.
        }
      })

      sync(root.dataset.theme ?? 'dark')
    </script>
  </body>
</html>
