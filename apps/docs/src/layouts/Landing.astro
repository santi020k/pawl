---
/**
 * The page shell for the landing page. The docs use Starlight's shell; this one shares its
 * theme setting ("starlight-theme" in localStorage), so a theme picked on either side sticks.
 */
import UIPrimitives from '@santi020k/lumen-astro/runtime'

import '../styles/tokens.css'
import '../styles/landing.css'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL('/og.jpg', Astro.site)
const ogImageAlt = 'pawl: fast guardrails for AI-written code. A steel ratchet wheel held by its pawl.'

// Only facts the page itself shows: the name, the description, the license and the author.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'pawl',
  description,
  url: canonical.href,
  image: ogImage.href,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Node.js',
  license: 'https://opensource.org/licenses/MIT',
  author: { '@type': 'Person', name: 'Santiago Molina', alternateName: 'santi020k', url: 'https://santi020k.com' }
}).replaceAll('<', '\\u003c')
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0B0D0C" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F5F7F2" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="pawl" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="robots" content="index, follow" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
    <script is:inline>
      // Same rule as Starlight's ThemeProvider, so both halves of the site agree before first paint.
      ;(() => {
        let stored = null
        try {
          stored = localStorage.getItem('starlight-theme')
        } catch {
          // Storage can be unavailable in private modes; fall back to the system setting.
        }
        const theme = stored || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
        document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark'
      })()
    </script>
  </head>
  <body>
    <slot />
    <UIPrimitives />
    <script>
      // The Lumen ThemeToggle runs in controlled mode: this page owns the theme so it can store it under
      // Starlight's key. Starlight reads "light", "dark" or "auto"; the toggle writes one of the first two.
      const root = document.documentElement

      const sync = (theme: string): void => {
        for (const toggle of document.querySelectorAll<HTMLButtonElement>('[data-ui-theme-toggle]')) {
          toggle.setAttribute('aria-pressed', String(theme === 'dark'))
          toggle.dataset.uiTheme = theme
        }
      }

      document.addEventListener('click', event => {
        const toggle = event.target instanceof Element ? event.target.closest('[data-ui-theme-toggle]') : null

        if (!toggle) return

        const next = root.dataset.theme === 'dark' ? 'light' : 'dark'

        root.dataset.theme = next
        sync(next)

        try {
          localStorage.setItem('starlight-theme', next)
        } catch {
          // Storage can be unavailable in private modes; the switch still applies to this page.
        }
      })

      sync(root.dataset.theme ?? 'dark')
    </script>
  </body>
</html>
