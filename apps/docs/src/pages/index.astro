---
import { Picture } from 'astro:assets'
import {
  Backdrop,
  ButtonLink,
  Card,
  CardContent,
  CardHeader,
  CardTitle,
  CodeTabs,
  Container,
  Grid,
  Icon,
  Pill,
  ScrollReveal,
  Stack,
  Tabs,
  TabsList,
  TabsPanel,
  TabsTrigger
} from '@santi020k/lumen-astro'

import ratchet from '../assets/ratchet.webp'
import { dependencyCount, dockerCheckCount, npmUrl, packCount, ruleCount } from '../components/landing/facts.ts'
import SiteFooter from '../components/landing/SiteFooter.astro'
import SiteHeader from '../components/landing/SiteHeader.astro'
import RatchetChart from '../components/RatchetChart.astro'
import Terminal from '../components/Terminal.astro'
import { explain, sessions } from '../data/demo.ts'
import Landing from '../layouts/Landing.astro'
import { currentVersion } from '../releases.ts'

const version = await currentVersion()

const install = [
  { value: 'npm', label: 'npm', code: 'npx @santi020k/pawl init', language: 'bash' },
  { value: 'pnpm', label: 'pnpm', code: 'pnpm dlx @santi020k/pawl init', language: 'bash' },
  { value: 'yarn', label: 'yarn', code: 'yarn dlx @santi020k/pawl init', language: 'bash' },
  { value: 'bun', label: 'bun', code: 'bunx @santi020k/pawl init', language: 'bash' }
]

const agentFiles = [
  {
    value: 'hook',
    label: '.claude/settings.json',
    language: 'json',
    code: `{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx pawl fix --hook"
          }
        ]
      }
    ]
  }
}`
  },
  {
    value: 'cursor',
    label: '.cursor/hooks.json',
    language: 'json',
    code: `{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "npx pawl fix --hook"
      }
    ]
  }
}`
  },
  {
    value: 'agents',
    label: 'AGENTS.md',
    language: 'markdown',
    code: `## Code quality

This repo uses pawl. After editing code, run:

    npx pawl check --changed --format agent

It prints one JSON line per problem, each with a \`fix\`. No output means there is nothing to do.
Run \`npx pawl fix\` to apply formatting and safe fixes.

Do not silence a problem with a disable comment (\`biome-ignore\`, \`eslint-disable\`, \`@ts-ignore\`).
New ones fail the check. Fix the code instead. Do not run \`pawl baseline\` to make findings go
away either: it accepts them as they are, and that is for a person to decide. A test that
loses assertions or gets skipped fails the check too: make it pass instead.`
  }
]

const policyFiles = [
  {
    value: 'repo',
    label: 'pawl.config.ts',
    language: 'ts',
    code: `import { definePolicy } from '@santi020k/pawl'

export default definePolicy({
  extends: '@santi020k/pawl-policy',
  rules: { 'no-console': 'off' },
  ignore: ['generated/**']
})`
  },
  {
    value: 'company',
    label: '@santi020k/pawl-policy',
    language: 'js',
    code: `// A real policy package on npm: the strict standard pawl's author uses.
// Fork it, or publish your own under your scope, such as @acme/pawl-policy.
export default {
  strict: true,
  rules: {
    'no-shadow': 'error',
    'no-param-reassign': 'error',
    'prefer-promise-reject-errors': 'error'
    // ...
  },
  locked: [
    'eqeqeq',
    '@typescript-eslint/no-explicit-any',
    '@typescript-eslint/ban-ts-comment'
    // ...
  ]
}`
  }
]

const ratchetSteps = [
  {
    title: 'Record once',
    body: 'When a repo adopts the standard, .pawl/baseline.json counts its findings per file and rule. Commit it, and nothing fails on day one.'
  },
  {
    title: 'New findings fail',
    body: 'Anything beyond those counts fails the check. So does a new biome-ignore, eslint-disable or @ts-ignore comment.'
  },
  {
    title: 'Lock in the gains',
    body: 'When the code improves, pawl says so. pawl baseline lowers the counts, and the repo cannot slip back past them.'
  }
]

const features = [
  {
    title: 'One command to set up',
    body: 'pawl init detects the stack and the tools already in use, shows what it will change, and asks before writing.',
    href: '/guide/getting-started/',
    icon: 'square-terminal'
  },
  {
    title: 'Coming from ESLint',
    body: 'pawl migrate reads your ESLint config the way ESLint resolves it, legacy .eslintrc included, and writes down only what differs from the standard.',
    href: '/guide/migrate/',
    icon: 'git-compare-arrows'
  },
  {
    title: `${packCount} optional packs`,
    body: 'For what only an ESLint plugin can check: Vitest, Testing Library, Zod, unicorn and more. Pawl holds the rules; your project installs the plugin.',
    href: '/guide/packs/',
    icon: 'blocks'
  },
  {
    title: 'Guards for AI SDKs',
    body: 'For the AI SDK, OpenAI, Anthropic, LangChain, MCP, Hono and more: no imports of package internals and no API keys in the code. No plugin needed.',
    href: '/guide/guards/',
    icon: 'shield-check'
  },
  {
    title: 'Docker checks',
    body: `${dockerCheckCount} checks of pawl's own for Dockerfiles and Compose files: unpinned images, secrets, running as root, privileged services.`,
    href: '/guide/guards/#dockerfiles-and-compose-files',
    icon: 'container'
  },
  {
    title: 'A shared standard',
    body: 'Extend @santi020k/pawl-policy or publish your own. Repos may tighten any rule, but locked rules cannot be loosened.',
    href: '/guide/policy/',
    icon: 'building-2'
  },
  {
    title: 'Monorepo aware',
    body: 'pnpm, npm and yarn workspaces, Turborepo and Nx. React rules apply in the React app and nowhere else.',
    href: '/guide/monorepos/',
    icon: 'folder-tree'
  },
  {
    title: 'Works with Quality',
    body: 'Quality runs every code-quality tool in a repo, in any language, with one command. It leaves the JavaScript engines to pawl and its baseline, and runs pawl as one of its tasks.',
    href: '/guide/quality/',
    icon: 'list-checks'
  },
  {
    title: 'Zero dependencies',
    body: 'TypeScript and Node built-ins. Every engine, formatter and plugin is an optional peer that your project installs.',
    href: '/guide/tools/',
    icon: 'feather'
  }
]

const lintEngines = ['Biome', 'Oxlint', 'ESLint']
const formatters = ['Biome', 'Prettier']

const engines = [
  { job: 'Lint', tools: lintEngines },
  { job: 'Format', tools: formatters }
]

const facts = [
  { value: ruleCount, label: 'rules in one standard', href: '/reference/rules/' },
  { value: packCount, label: 'optional ESLint packs', href: '/guide/packs/' },
  { value: lintEngines.length, label: 'lint engines to choose from', href: '/guide/tools/' },
  { value: dependencyCount, label: 'runtime dependencies', href: '/guide/install/#the-tools' }
]
---

<Landing
  title="pawl: fast lint and format guardrails for AI-written code"
  description="One lint and format standard for Biome, Oxlint, ESLint and Prettier. Existing findings are recorded once; from then on, only new ones fail the check."
>
  <SiteHeader />

  <main id="main">
    <section class="hero" data-theme="dark" aria-labelledby="hero-title">
      <Picture
        src={ratchet}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[768, 1152, 1536]}
        sizes="(max-width: 56rem) 100vw, 70vw"
        alt="A steel ratchet wheel with its pawl locked into one tooth, edges lit in lime."
        class="hero__art"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero__grid" aria-hidden="true"></div>

      <Container class="hero__inner">
        <Stack gap="xl" class="hero__copy">
          <Pill href="/changelog/" variant="brand" class="hero__release">
            {version ? `v${version} on npm · See what's new` : 'Early release'}
            <Icon name="arrow-up-right" decorative size="sm" />
          </Pill>
          <h1 id="hero-title">Fast guardrails for <span class="lime"><span class="nowrap">AI-written</span> code.</span></h1>
          <p class="hero__lede">
            One standard, for the linter and formatter you choose. Existing findings are recorded once; from then on, quality can
            only move forward.
          </p>
          <Stack direction="horizontal" gap="md" wrap>
            <ButtonLink href="/guide/getting-started/" variant="primary" showArrow>Get started</ButtonLink>
            <ButtonLink href="#ratchet" variant="secondary">How the ratchet works</ButtonLink>
          </Stack>
          <CodeTabs ariaLabel="Package manager" items={install} storageKey="pawl-package-manager" copy class="hero__install" />
        </Stack>
      </Container>

      <Container class="hero__facts">
        <ul class="facts" aria-label="pawl in numbers">
          {
            facts.map(fact => (
              <li class="facts__item">
                <a class="facts__link" href={fact.href}>
                  <span class="facts__value">{fact.value}</span>
                  <span class="facts__label">{fact.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </Container>
    </section>

    <section class="band" aria-labelledby="run-title">
      <Container>
        <div class="split split--wide">
          <div class="band-head">
            <p class="kicker">In the terminal</p>
            <h2 id="run-title">Old findings are allowed. New ones are not.</h2>
            <p>
              Pawl runs the engine you chose, then compares the result with the baseline the repo recorded on day one. These are
              real runs on a small repo.
            </p>
          </div>

          <Tabs initialValue="check" indicator class="runs">
            <TabsList aria-label="Example runs">
              {sessions.map(session => <TabsTrigger value={session.id}>{session.label}</TabsTrigger>)}
            </TabsList>
            {
              sessions.map(session => (
                <TabsPanel value={session.id}>
                  <Terminal lines={session.lines} />
                  <p class="runs__caption">{session.caption}</p>
                </TabsPanel>
              ))
            }
          </Tabs>
        </div>
      </Container>
    </section>

    <section class="band" id="ratchet" aria-labelledby="ratchet-title">
      <Container>
        <div class="band-head">
          <p class="kicker">The ratchet</p>
          <h2 id="ratchet-title">Quality can only move forward.</h2>
          <p>
            A pawl is the part of a ratchet that stops it slipping backward. This tool does the same for a codebase, so a team, or
            an agent writing code for it, can adopt a strict standard without fixing everything first.
          </p>
        </div>

        <ScrollReveal animation="fade" threshold={0.4} class="chart-reveal">
          <Card class="chart-card" density="spacious">
            <RatchetChart />
          </Card>
        </ScrollReveal>

        <ol class="steps">
          {
            ratchetSteps.map((step, index) => (
              <li>
                <span class="steps__index" aria-hidden="true">0{index + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
      </Container>
    </section>

    <section class="band" aria-labelledby="tools-title">
      <Container>
        <div class="split">
          <Stack gap="xl">
            <div class="band-head">
              <p class="kicker">Your tools</p>
              <h2 id="tools-title">One standard, compiled for the engine you use.</h2>
              <p>
                The standard has {ruleCount} rules, named once with ESLint's names. Pawl compiles them for each engine, and every finding
                shows the engine's own rule name.
              </p>
            </div>

            <dl class="engines">
              {
                engines.map(row => (
                  <div class="engines__row">
                    <dt>{row.job}</dt>
                    <dd>
                      {row.tools.map((tool, index) => (
                        <span class:list={['engine', { 'engine--default': index === 0 }]}>
                          {tool}
                          {index === 0 && <small>default</small>}
                        </span>
                      ))}
                    </dd>
                  </div>
                ))
              }
            </dl>

            <p class="note">
              The engines stay usable on their own: <code>biome check</code> and <code>eslint .</code> read the same config files.
            </p>
          </Stack>

          <Terminal lines={explain} title="pawl explain" />
        </div>
      </Container>
    </section>

    <section class="band" aria-labelledby="agents-title">
      <Container>
        <div class="split">
          <div class="band-head">
            <p class="kicker">Built for coding agents</p>
            <h2 id="agents-title">Findings an agent can act on.</h2>
            <p>
              <code>--format agent</code> prints one compact JSON line per finding, with the fix, and nothing at all when there is
              nothing to do. <code>pawl init --agents</code> adds hooks that fix each edit and hand what is left back to Claude Code,
              Codex and Copilot, a Cursor hook that fixes what it can, instructions in <code>AGENTS.md</code> that every agent
              reads, and a pawl skill.
            </p>
            <ButtonLink href="/guide/agents/" variant="inline" showArrow>Set up agents</ButtonLink>
          </div>

          <CodeTabs ariaLabel="Files that pawl init --agents writes" items={agentFiles} copy />
        </div>
      </Container>
    </section>

    <section class="band" aria-labelledby="features-title">
      <Container>
        <div class="band-head">
          <p class="kicker">What else</p>
          <h2 id="features-title">Small config files. Clear defaults. No surprises.</h2>
          <p>
            Pawl never deletes or overwrites a tool config you already have, and a rule an engine cannot enforce is reported,
            never papered over.
          </p>
        </div>

        <Grid columns="auto" minItemWidth="18rem" gap="lg" as="ul" class="features">
          {
            features.map(feature => (
              <li>
                <Card variant="interactive" class="feature">
                  <CardHeader>
                    <span class="feature__icon" aria-hidden="true"><Icon name={feature.icon} decorative size="lg" /></span>
                    <CardTitle as="h3">
                      <a href={feature.href}>{feature.title}</a>
                    </CardTitle>
                  </CardHeader>
                  <CardContent>
                    <p>{feature.body}</p>
                  </CardContent>
                </Card>
              </li>
            ))
          }
        </Grid>
      </Container>
    </section>

    <section class="band" aria-labelledby="policy-title">
      <Container>
        <div class="split split--reverse">
          <CodeTabs ariaLabel="A repo policy and the company policy it extends" items={policyFiles} copy />

          <div class="band-head">
            <p class="kicker">A shared standard</p>
            <h2 id="policy-title">One policy for every repo.</h2>
            <p>
              A repo on the default standard needs no config file. To change something, add <code>pawl.config.ts</code>. To set the
              standard for many repos, extend a policy package such as <code>@santi020k/pawl-policy</code>, or publish your own
              under your scope and lock the rules that matter.
            </p>
            <ButtonLink href="/guide/policy/" variant="inline" showArrow>Read about policies</ButtonLink>
          </div>
        </div>
      </Container>
    </section>

    <section class="band cta" data-theme="dark" aria-labelledby="cta-title">
      <Backdrop variant="grid" tone="brand" intensity="subtle" class="cta__backdrop">
        <Container size="md">
          <Stack gap="xl" align="center" class="cta__inner">
            <h2 id="cta-title">Set up a repo in one command.</h2>
            <p>
              {version ? `Pawl ${version} is on npm.` : 'Pawl is early.'} It is tested against the real Biome and ESLint, and until
              1.0 a minor release may still change the API.
            </p>
            <CodeTabs ariaLabel="Package manager" items={install} storageKey="pawl-package-manager" copy class="cta__install" />
            <Stack direction="horizontal" gap="md" wrap justify="center">
              <ButtonLink href="/guide/getting-started/" variant="primary" showArrow>Read the guide</ButtonLink>
              <ButtonLink href="https://github.com/santi020k/pawl" variant="secondary">Star on GitHub</ButtonLink>
            </Stack>
          </Stack>
        </Container>
      </Backdrop>
    </section>
  </main>

  <SiteFooter />
</Landing>

<style>
  /* Hero: always dark, with the ratchet art on the right fading into the canvas. */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: hsl(var(--canvas));
    color: hsl(var(--ink));
    border-bottom: 1px solid hsl(var(--line) / 0.7);
  }

  /* The art fades out to the left, under the copy, and toward the bottom, under the numbers. */
  .hero :global(.hero__art) {
    position: absolute;
    inset: 0 0 0 auto;
    z-index: -2;
    width: min(70%, 68rem);
    height: 100%;
    object-fit: cover;
    object-position: 60% 40%;
    mask-image:
      linear-gradient(90deg, transparent 0%, #000 45%),
      linear-gradient(180deg, #000 55%, transparent 88%);
    mask-composite: intersect;
    -webkit-mask-image:
      linear-gradient(90deg, transparent 0%, #000 45%),
      linear-gradient(180deg, #000 55%, transparent 88%);
    -webkit-mask-composite: source-in;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(hsl(var(--brand) / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, hsl(var(--brand) / 0.06) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(120% 90% at 0% 40%, #000 30%, transparent 70%);
    -webkit-mask-image: radial-gradient(120% 90% at 0% 40%, #000 30%, transparent 70%);
  }

  .hero :global(.hero__inner) {
    padding-block: clamp(4.5rem, 10vw, 7.5rem) clamp(3rem, 6vw, 4.5rem);
  }

  /* Wide enough for the headline to set in two lines on a laptop. */
  .hero :global(.hero__copy) {
    max-width: 46rem;
  }

  .hero :global(.hero__release) {
    align-self: flex-start;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding-inline: 1rem 0.875rem;
    font-family: var(--pawl-font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.75rem, 6.4vw, 4.75rem);
    line-height: 1.02;
    font-weight: 660;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .nowrap {
    white-space: nowrap;
  }

  .hero__lede {
    margin: 0;
    max-width: 34rem;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    color: hsl(var(--ink-soft));
    text-wrap: pretty;
  }

  .hero :global(.hero__install) {
    max-width: 30rem;
  }

  /*
   * The numbers rail at the foot of the hero. Its top edge is a row of ratchet teeth: each tooth
   * rises on a slope and drops straight down, so it only turns one way.
   */
  .facts {
    --facts-pad-top: 1.75rem;
    --facts-pad-x: 1.5rem;
    --facts-pad-bottom: 0.5rem;
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
    padding: 0;
    list-style: none;
  }

  .facts::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 0.4375rem;
    background: linear-gradient(to top left, hsl(var(--brand) / 0.26) 50%, transparent 50%) 0 100% / 0.875rem 100% repeat-x;
  }

  .facts__item {
    display: flex;
    min-width: 0;
  }

  .facts__item + .facts__item {
    border-inline-start: 1px solid hsl(var(--line) / 0.7);
  }

  /* The first column lines up with the copy above it. */
  .facts__item:first-child {
    --facts-pad-start: 0px;
  }

  .facts__link {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    width: 100%;
    padding: var(--facts-pad-top) var(--facts-pad-x) var(--facts-pad-bottom);
    padding-inline-start: var(--facts-pad-start, var(--facts-pad-x));
    border-radius: var(--ui-radius);
    color: inherit;
    text-decoration: none;
  }

  .facts__link:focus-visible {
    outline-offset: -2px;
  }

  .facts__value {
    font-size: clamp(2.25rem, 3.6vw, 3rem);
    line-height: 1;
    font-weight: 620;
    letter-spacing: -0.05em;
    color: hsl(var(--ink));
    transition: color var(--ui-duration) var(--ui-ease);
  }

  .facts__label {
    font-size: 0.9375rem;
    color: hsl(var(--ink-soft));
  }

  .facts__link:hover .facts__value {
    color: hsl(var(--brand));
  }

  @media (max-width: 56rem) {
    /* On a phone the art sits above the copy, where it can show the pawl and the teeth it holds. */
    .hero :global(.hero__art) {
      inset: 0 0 auto auto;
      width: 100%;
      height: 26rem;
      object-position: 82% 30%;
      opacity: 0.8;
      mask-image:
        linear-gradient(90deg, transparent 0%, #000 55%),
        linear-gradient(180deg, #000 30%, transparent 92%);
      -webkit-mask-image:
        linear-gradient(90deg, transparent 0%, #000 55%),
        linear-gradient(180deg, #000 30%, transparent 92%);
    }

    .hero :global(.hero__inner) {
      padding-top: 11rem;
    }

    .facts {
      --facts-pad-top: 1.25rem;
      --facts-pad-x: 1rem;
      --facts-pad-bottom: 1rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .facts__item:nth-child(odd) {
      --facts-pad-start: 0px;
      border-inline-start: 0;
    }

    .facts__item:nth-child(n + 3) {
      border-top: 1px solid hsl(var(--line) / 0.7);
    }
  }

  /* Two-column bands. */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .split--wide {
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
  }

  .split--reverse {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
  }

  .split .band-head {
    margin-bottom: 0;
  }

  .split .band-head :global(.ui-button-link) {
    margin-top: 1.25rem;
  }

  @media (max-width: 56rem) {
    .split,
    .split--wide,
    .split--reverse {
      grid-template-columns: minmax(0, 1fr);
    }

    .split--reverse > :first-child {
      order: 2;
    }
  }

  code {
    font-family: var(--pawl-font-mono);
    font-size: 0.9em;
    padding: 0.1em 0.35em;
    border-radius: 0.3rem;
    background: hsl(var(--brand-soft));
    color: hsl(var(--brand));
  }

  /* Example runs. Panels must be allowed to shrink so long lines scroll inside the terminal. */
  :global(.runs),
  :global(.runs [role='tabpanel']) {
    min-width: 0;
  }

  .runs :global([role='tablist']) {
    margin-bottom: 1rem;
  }

  .runs :global([role='tab']) {
    font-family: var(--pawl-font-mono);
    font-size: 0.8125rem;
  }

  .runs__caption {
    margin: 0.875rem 0 0;
    font-size: 0.9375rem;
    color: hsl(var(--ink-muted));
  }

  /* The ratchet. The card stays put while the chart inside it draws itself (see RatchetChart). */
  .band :global(.chart-reveal) {
    opacity: 1;
    transform: none;
  }

  .band :global(.chart-card) {
    background: hsl(var(--surface));
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    padding-top: 1.25rem;
