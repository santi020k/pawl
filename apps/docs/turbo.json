{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "!dist/**", "!.astro/**", "!public/og/**", "!.og-cache.json"],
      "outputs": ["dist/**", "public/og/**"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "!dist/**", "!.astro/**", "!public/og/**", "!.og-cache.json"]
    }
  }
}
