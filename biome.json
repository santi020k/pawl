{
  "extends": ["./packages/pawl/presets/pawl.biome.json", "./packages/pawl/presets/turbo.biome.json"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "javascript": {
    "globals": ["HTMLRewriter", "WebSocketPair"]
  },
  "overrides": [
    {
      "includes": ["apps/docs/**"],
      "linter": {
        "domains": {
          "astro": "recommended"
        },
        "rules": {}
      }
    }
  ],
  "html": {
    "experimentalFullSupportEnabled": true
  }
}
