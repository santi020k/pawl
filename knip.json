{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["quality"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"],
      "ignoreDependencies": ["@biomejs/biome"]
    },
    "packages/pawl": {
      "entry": ["src/index.ts", "src/cli.ts", "scripts/*.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["prettier"]
    },
    "packages/pawl-policy": {
      "entry": ["index.js", "test/**/*.test.ts"]
    },
    "apps/docs": {
      "entry": ["og.config.mjs"],
      "ignoreDependencies": ["@fontsource-variable/geist", "@fontsource-variable/geist-mono"]
    }
  }
}
