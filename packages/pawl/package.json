{
  "name": "@santi020k/pawl",
  "version": "0.1.0",
  "description": "Fast guardrails for AI-written code. One standard for Biome, Oxlint, ESLint and Prettier.",
  "keywords": [
    "lint",
    "format",
    "biome",
    "eslint",
    "code-quality",
    "ai",
    "agents",
    "ratchet",
    "baseline",
    "prettier",
    "oxlint"
  ],
  "homepage": "https://pawl.santi020k.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santi020k/pawl.git",
    "directory": "packages/pawl"
  },
  "license": "MIT",
  "author": "santi020k",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./biome": "./presets/pawl.biome.json",
    "./biome/react": "./presets/react.biome.json",
    "./biome/next": "./presets/next.biome.json",
    "./biome/react-native": "./presets/react-native.biome.json",
    "./biome/qwik": "./presets/qwik.biome.json",
    "./biome/solid": "./presets/solid.biome.json",
    "./biome/vue": "./presets/vue.biome.json",
    "./biome/svelte": "./presets/svelte.biome.json",
    "./biome/astro": "./presets/astro.biome.json",
    "./biome/tailwind": "./presets/tailwind.biome.json",
    "./biome/tanstack-query": "./presets/tanstack-query.biome.json",
    "./biome/drizzle": "./presets/drizzle.biome.json",
    "./biome/playwright": "./presets/playwright.biome.json",
    "./biome/turbo": "./presets/turbo.biome.json",
    "./schema.json": "./pawl.config.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "pawl": "./dist/cli.js"
  },
  "files": [
    "dist",
    "presets",
    "pawl.config.schema.json",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "docs:rules": "node scripts/build-rules-doc.ts && biome format --write ../../apps/docs/src/content/docs/reference/rules.md",
    "oxlint-rules": "node scripts/build-oxlint-rules.ts",
    "preset": "node scripts/build-preset.ts",
    "schema": "node scripts/build-schema.ts && biome format --write pawl.config.schema.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
