{
  "linter": {
    "domains": {
      "vue": "recommended"
    },
    "rules": {
      "nursery": {
        "noVueMutatingProps": "off",
        "useVueBlockOrder": "off",
        "useVueDefaultProp": "off",
        "useVueTypedProps": "off"
      },
      "style": {
        "useVueMultiWordComponentNames": "warn"
      }
    }
  }
}
