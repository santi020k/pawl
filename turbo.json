{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_OPTIONS", "NO_COLOR", "OXLINT_TSGOLINT_PATH"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "scripts/**", "tsconfig*.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
